# Supabase project URL and public anon key (used to validate user access tokens)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase Postgres connection string. Prefer the pooled connection string in production.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Keep this secret on the backend only. Never place it in the Flutter app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Development only. Set false in production.
DEBUG=true
